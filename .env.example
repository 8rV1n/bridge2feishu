# opencode-feishu-share 环境变量样例 —— 复制为 .env 或写入 shell 配置
# 传输层：缺省 mock（本地 JSONL，测试用）；lark = 真实飞书 WS 长连接
FEISHU_SHARE_TRANSPORT=lark

# 飞书应用凭证（只放环境变量，切勿写入代码/仓库）
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
# 国内版 https://open.feishu.cn；国际版 https://open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn

# 通知目标：群 chat_id（oc_）或单聊 open_id（ou_）
FEISHU_DEFAULT_CHAT_ID=oc_xxxxxxxx
FEISHU_RECEIVE_ID_TYPE=chat_id

# 安全白名单（默认拒绝一切未授权）
FEISHU_ALLOWED_OPEN_IDS=ou_your_open_id
FEISHU_ALLOWED_CHAT_IDS=oc_target_chat_id

# 可选：mock/审计数据目录（默认 ~/.local/share/opencode/feishu-share）
# FEISHU_SHARE_STATE_DIR=/tmp/feishu-share-test
